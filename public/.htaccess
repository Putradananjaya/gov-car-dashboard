# Angular adalah SPA (routing di sisi klien) — tanpa ini, refresh atau tautan
# langsung ke rute selain "/" akan 404 di Apache/cPanel karena file fisiknya
# memang tidak ada. Semua permintaan yang bukan berkas/direktori nyata
# diarahkan ke index.html supaya Angular Router yang menanganinya.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
