DB_HOST=localhost
DB_PORT=5434
DB_USER=pusaka
DB_PASSWORD=pusaka_dev_only
DB_NAME=pusaka_bangli
PORT=3000
NODE_ENV=development

# Ganti dengan rahasia acak sendiri (mis. `openssl rand -hex 32`) — JANGAN
# pernah pakai nilai placeholder ini di lingkungan manapun selain lokal.
JWT_SECRET=change-me-in-dot-env
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Origin frontend yang diizinkan CORS + penerima cookie refresh token.
FRONTEND_ORIGIN=http://localhost:4300

# Produksi (Railway dsb.): DATABASE_URL disediakan otomatis oleh plugin
# Postgres, TIDAK perlu diisi manual — kalau ada, DB_HOST/DB_PORT/dst di atas
# diabaikan (lihat server/src/app.module.ts).
# DATABASE_URL=
